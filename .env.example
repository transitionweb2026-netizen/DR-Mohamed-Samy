# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings -> API in the Supabase dashboard).
# .env.local is gitignored - never commit real keys.

# Project URL and anon (public) key - safe to expose to the browser, used by
# the CMS dashboard's client-side auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role (secret) key - SERVER-ONLY, never exposed to the browser.
# Used to read content for the public site and for privileged admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# Used for absolute URLs in metadata/sitemap/hreflang. Set to the real
# production domain once deployed; localhost is fine for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
